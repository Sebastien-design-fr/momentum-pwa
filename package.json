{
  "name": "momentum-pwa",
  "version": "0.13.0",
  "private": true,
  "description": "MOMENTUM — PWA iPhone de coaching quotidien et de suivi emploi.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "TZ=Europe/Paris node --test tests/*.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm test",
    "version:set": "node scripts/set-version.mjs",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
